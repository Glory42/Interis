# Optional overrides for `docker compose up`. Copy this file to `.env` at the
# repo root to customize; docker-compose.yml already has working defaults for
# everything below so `docker compose up` runs with zero manual setup.

# A real Bearer token is only needed if you want TMDB-backed features (search,
# archive, detail pages) to return real data instead of failing TMDB calls.
TMDB_ACCESS_TOKEN=Bearer <your-tmdb-token>

# Any string 32+ characters long; signs access-token JWTs.
JWT_ACCESS_SECRET=<generate-a-random-string>
