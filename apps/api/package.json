{
  "name": "backend",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "test": "bun test",
    "test:integration": "bun test tests/integration --timeout 15000",
    "test:contract": "bun test tests/contract",
    "test:unit": "bun test tests/unit",
    "test:db:migrate": "bunx drizzle-kit migrate",
    "test:db:reset": "bun run scripts/test-db-reset.ts",
    "test:ci": "bun run test:integration",
    "typecheck": "bunx tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:arch": "bun run scripts/architecture-check.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/bun": "latest",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.3.3",
    "@types/pg": "^8.15.6",
    "@types/pino-http": "^6.1.0",
    "drizzle-kit": "^0.31.9",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "pg": "^8.16.3",
    "pino-pretty": "^13.1.3",
    "typescript-eslint": "^8.48.0"
  },
  "peerDependencies": {
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1017.0",
    "@aws-sdk/s3-request-presigner": "^3.1017.0",
    "@better-auth/drizzle-adapter": "^1.5.3",
    "@neondatabase/serverless": "^1.0.2",
    "better-auth": "^1.5.3",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "drizzle-orm": "^0.45.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.1",
    "helmet": "^8.3.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "zod": "^4.3.6"
  }
}
