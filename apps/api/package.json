{
  "name": "backend",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "test": "bun test",
    "test:integration": "bun test tests/integration --timeout 15000",
    "test:contract": "bun test tests/contract",
    "test:unit": "bun test tests/unit",
    "test:db:migrate": "bunx drizzle-kit migrate",
    "test:db:reset": "bun run scripts/test-db-reset.ts",
    "auth:backfill-credentials": "bun run scripts/backfill-auth-credentials.ts",
    "test:ci": "bun run test:integration",
    "typecheck": "bunx tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:arch": "bun run scripts/architecture-check.ts",
    "cf:dev": "wrangler dev",
    "cf:deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260719.1",
    "@eslint/js": "^9.39.1",
    "@types/bun": "latest",
    "@types/node": "^25.3.3",
    "@types/pg": "^8.15.6",
    "drizzle-kit": "^0.31.9",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "pg": "^8.16.3",
    "pino-pretty": "^13.1.3",
    "typescript-eslint": "^8.48.0",
    "wrangler": "^4.112.0"
  },
  "peerDependencies": {
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1017.0",
    "@aws-sdk/s3-request-presigner": "^3.1017.0",
    "@neondatabase/serverless": "^1.0.2",
    "argon2id": "^1.0.1",
    "dotenv": "^17.3.1",
    "drizzle-orm": "^0.45.1",
    "hono": "^4.12.31",
    "jose": "^6.2.3",
    "pino": "^10.3.1",
    "zod": "^4.3.6"
  }
}
