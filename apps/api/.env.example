# Copy to apps/api/.env and fill in the secrets. Defaults below target the
# local Postgres from the repo's docker-compose - dev and tests must never
# point at Neon (that drains the Free plan's 5 GB/mo network-transfer quota;
# see the 2026-09-08 investigation). Bring the DB up with:
#   docker compose up postgres db-proxy

PORT=5000
CORS_ORIGIN=http://localhost:5173
# Driver reads naive timestamps back in the process TZ - pin to UTC.
TZ=UTC

# dev: neon-http driver -> local HTTP proxy on :4444 (USE_LOCAL_DB_PROXY=true)
DATABASE_URL=postgres://interis:interis@localhost:5432/interis
# tests + drizzle-kit: straight over the Postgres wire protocol, no proxy.
# Required when NODE_ENV=test - db.ts throws rather than fall back to Neon.
DIRECT_DATABASE_URL=postgres://interis:interis@localhost:5432/interis
USE_LOCAL_DB_PROXY=true

# Any string 32+ chars; signs access-token JWTs.
JWT_ACCESS_SECRET=

# "Bearer <token>" - only needed for real TMDB-backed data locally.
TMDB_ACCESS_TOKEN=

# Optional third-party archive integrations.
GOOGLE_BOOKS_API_KEY=
NYT_BOOKS_API_KEY=
NYT_BOOKS_API_SECRET=
MUSICBRAINZ_USER_AGENT=Interis/1.0 (example.com)
LASTFM_API_KEY=
LASTFM_API_SHARED_SECRET=

# Optional R2 asset storage.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
